@echo off
REM Cleanup script for rltoolsR package (Windows)
REM Removes compiled objects, shared libraries, and build artifacts.
REM src\Makevars and src\Makevars.win are static (no configure) and are kept.
for /R src %%f in (*.o *.so *.dll *.dylib *.a) do @del /Q "%%f" 2>NUL

REM Remove build artifacts
del /Q src\symbols.rds 2>NUL

REM Remove R CMD check directories
rmdir /S /Q ..Rcheck 2>NUL
rmdir /S /Q rltoolsR.Rcheck 2>NUL
