#!/bin/sh

# Configure script for rltoolsR (Windows/Rtools): generates src/Makevars.win
# from src/Makevars.win.in. The gcc workaround is the same as in ./configure:
# with gcc (not clang) the C and C++ sources get -fno-tree-slp-vectorize.
# (Rtools builds for baseline x86-64, where the gcc 15 miscompile does not show,
# but the flag keeps a gcc build the same everywhere.)

: "${R_HOME:=$(R RHOME)}"
CC=$("${R_HOME}/bin/R" CMD config CC)
CXX=$("${R_HOME}/bin/R" CMD config CXX17)

is_gcc() {
  printf '#if !defined(__GNUC__) || defined(__clang__)\n#error not gcc\n#endif\n' |
    $1 -x "$2" -E - >/dev/null 2>&1
}

accepts() {
  printf 'int main(void) { return 0; }\n' |
    $1 "$3" -x "$2" -c -o /dev/null - >/dev/null 2>&1
}

GCC_SLP_CFLAGS=""
GCC_SLP_CXXFLAGS=""
if is_gcc "$CC" c && accepts "$CC" c -fno-tree-slp-vectorize; then
  GCC_SLP_CFLAGS="-fno-tree-slp-vectorize"
fi
if is_gcc "$CXX" c++ && accepts "$CXX" c++ -fno-tree-slp-vectorize; then
  GCC_SLP_CXXFLAGS="-fno-tree-slp-vectorize"
fi
echo "C compiler:   $CC  -> ${GCC_SLP_CFLAGS:-no extra flags}"
echo "C++ compiler: $CXX  -> ${GCC_SLP_CXXFLAGS:-no extra flags}"

echo "Generating src/Makevars.win..."
sed \
  -e "s|@GCC_SLP_CFLAGS@|$GCC_SLP_CFLAGS|g" \
  -e "s|@GCC_SLP_CXXFLAGS@|$GCC_SLP_CXXFLAGS|g" \
  src/Makevars.win.in > src/Makevars.win
